# Local server configuration. Never commit real credentials or provider tokens.
CONFLUX_ENVIRONMENT=local
CONFLUX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CONFLUX_DATABASE_URL=jdbc:postgresql://localhost:5432/conflux
CONFLUX_DATABASE_USERNAME=conflux
CONFLUX_DATABASE_PASSWORD=conflux_local_only
CONFLUX_REDIS_HOST=localhost
CONFLUX_REDIS_PORT=6379
CONFLUX_STUN_URLS=
# Set only in the deployment secret manager; never expose provider secrets to Next.js.
CONFLUX_RAZORPAY_KEY_ID=
CONFLUX_RAZORPAY_KEY_SECRET=
CONFLUX_RAZORPAY_WEBHOOK_SECRET=
