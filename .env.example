# The browser may call only a public, HTTPS API origin. Leave blank while
# developing the frontend without a running service.
NEXT_PUBLIC_CONFLUX_API_URL=http://localhost:8080

# Browser-safe Supabase settings. These are public values; do not put a
# service-role key in NEXT_PUBLIC_ variables or commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
